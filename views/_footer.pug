footer.footer#footer
    .shell
        .footer__top
            div
                a.brand(href='/' aria-label='Raahsta home')
                    +brand
                p.footer__tagline A little further from ordinary.
            nav.footer__nav(aria-label='Footer navigation')
                a(href='/photo-credits.html') Photo credits
                a(href='/#tours') Find an adventure
                a(href='/#our-way') Our way of travelling
                if user
                    a(href='/my-tours') My journeys
                    a(href='/me') Your account
                else
                    a(href='/signup') Join Raahsta
                    a(href='/login') Log in
        .footer__bottom
            p &copy; #{new Date().getFullYear()} Raahsta. Built by Satyam Pandey.
            span Made for the journey, not just the destination.
