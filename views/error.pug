extends base

block content
    main.shell.error-page#main-content
        .empty-state
            span.empty-state__icon(aria-hidden='true') ↗
            p.eyebrow A little detour
            h1= title || 'We’ve wandered off the path.'
            p= msg || 'Something went wrong. Please try again in a moment.'
            a.btn.btn--green(href='/') Back to exploring
