extends base

block content
    main.auth-page.shell#main-content
        .auth-story
            img(src='/img/tours/india-manali-cover.jpg' alt='Mountain scenery near Manali, India' width='1600' height='1000')
            .auth-story__copy
                p.eyebrow Follow your curiosity.
                h1 More places.
                    br
                    em More you.
                p Your next chapter starts with a little adventure.
        .auth-panel
            .signup-form
                p.eyebrow Find your Raahsta
                h2 A world of possibility.
                p.form-intro Create an account. Leave ordinary behind.
                form.form#userSignUp
                    .form__group
                        label.form__label(for='name') Your name
                        input#name.form__input(type='text' placeholder='What should we call you?' autocomplete='name' required)
                    .form__group
                        label.form__label(for='email') Email address
                        input#email.form__input(type='email' placeholder='you@example.com' autocomplete='email' required)
                    .form__group
                        label.form__label(for='password') Password
                        input#password.form__input(type='password' placeholder='At least 8 characters' autocomplete='new-password' required minlength='8' aria-describedby='password-hint')
                        small.form-hint#password-hint Make it memorable for you, hard to guess for others.
                    .form__group
                        label.form__label(for='confirmpassword') Confirm password
                        input#confirmpassword.form__input(type='password' placeholder='One more time' autocomplete='new-password' required minlength='8')
                    button.btn.btn--green.btn--full(type='submit') Sign up
                p.auth-switch Already part of the journey?
                    | &nbsp;
                    a(href='/login') Log in
