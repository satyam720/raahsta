# Copy to config.env for local development. Set real values in Render's dashboard.
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
# Leave empty locally to use public/img; on Render use /var/data/raahsta.
UPLOAD_DIR=
DATABASE=mongodb+srv://USERNAME:<db_password>@CLUSTER/raahsta
DATABASE_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
MAPBOX_ACCESS_TOKEN=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
EMAIL_FROM=
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_LOGIN=
BREVO_PASSWORD=
# Local development email sandbox:
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
