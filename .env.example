# Copy to config.env for local development. Set real values in Render's dashboard.
NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0
# Local uploads use public/img. Set UPLOAD_STORAGE=cloudinary on Render.
UPLOAD_STORAGE=local
UPLOAD_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DATABASE=mongodb+srv://USERNAME:<db_password>@CLUSTER/raahsta
DATABASE_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
MAPBOX_ACCESS_TOKEN=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
EMAIL_FROM=
# Production uses a Brevo API key, not an SMTP key.
BREVO_API_KEY= 
# Local development email sandbox:
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
